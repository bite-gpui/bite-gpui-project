#!/usr/bin/env bash
#
# The Windows guest for the interop probes, with the discrete GPU passed through.
#
# W5's probes (P5, P6, P9) and the PR-2 sufficiency test need a **real** Direct3D device: a
# software/WARP adapter is explicitly not representative (`probe-p6-adapter-luid.md` §5), and the
# fork's `windows-latest` CI has no GPU. This passes the machine's discrete GPU into a QEMU guest
# instead.
#
# The GPU is `0000:01:00.0`, a **MUX-less 3D controller** (no display output) alone in IOMMU
# group 10, which the host desktop does not use — it is on the Intel iGPU. The guest still gets a
# `-vga std` console, so it has *two* adapters, which is closer to the hybrid shape P6 warns about
# than a single-adapter host is. NVIDIA's consumer driver refuses to run in a VM (Code 43) unless
# the hypervisor hides itself, hence `kvm=off`.
#
# Build the ISO with `script/windows-iso` (a **client** Windows — Server cannot take a GeForce
# driver), then:
#
#     sudo script/interop-vm bind
#     script/interop-vm create
#     script/interop-vm install --iso ../windows-iso/uup/....iso
#     script/interop-vm run
#     sudo script/interop-vm unbind      # return the GPU to the host when done
#
# Usage:
#     script/interop-vm check                    # report the prerequisites (read-only)
#     sudo script/interop-vm bind                # bind the GPU to vfio-pci
#     sudo script/interop-vm unbind              # return it to the nvidia driver
#     script/interop-vm create                   # create the qcow2 disk
#     script/interop-vm install --iso ISO        # boot the installer, GPU passed through
#     script/interop-vm run                      # boot the installed disk
#     sudo script/interop-vm prepare             # keep the GPU for VFIO at boot, then reboot
#     sudo script/interop-vm prepare --revert    # undo that
#     script/interop-vm screenshot [--out F]     # save the running guest's screen to a PNG
#     script/interop-vm sendkey --keys KEYS      # inject keys into the running guest
#     script/interop-vm type --text STR          # type a string into the running guest
#     script/interop-vm powerdown                # ask the guest to shut down (ACPI)
#     sudo script/interop-vm poweron              # run the board's ACPI _ON for the dGPU (muxless)
#     script/interop-vm bake                     # freeze the disk as a golden image; run on an overlay
#     script/interop-vm clone --to DIR           # a fresh VM: a new overlay on the golden image
#     sudo script/interop-vm gvt                 # recreate the mediated Intel GPU after a reboot
#
# Options:
#     --iso PATH       the installer ISO (required by `install`)
#     --dir DIR        VM directory (default $HOME/interop-vm); for `clone`, where the golden image is
#     --to DIR         `clone`: the directory to create the new VM in
#     --cache MODE     QEMU disk cache mode for the guest disk, e.g. `unsafe` (default: QEMU's)
#                      `unsafe` skips flushes to the *guest image only* -- it can lose guest
#                      writes on a host crash, but cannot touch anything else on the host
#     --disk SIZE      disk size for `create` (default 64G)
#     --ram SIZE       guest RAM (default 4G)
#     --cpus N         guest CPUs (default 2)
#     --uefi           boot OVMF instead of SeaBIOS (only if the GPU has a UEFI GOP)
#     --vnc            no local window; serve VNC on 127.0.0.1:0 (localhost only)
#     --rom PATH       pass a VBIOS dump to the GPU (`romfile=`)
#     --no-rom         hide the GPU option ROM (`rombar=0`) instead of passing it
#     --no-gpu         don't pass the GPU through (plain install or debug run)
#     --x-vga          pass x-vga=on to the GPU (make it the primary/boot VGA);
#                      needs a VGA-capable device -- VFIO rejects it for a 0302 3D controller
#     --no-vga         drop QEMU's emulated `-vga std` (use with --x-vga, or alone)
#     --gpu-subsys VVVV:DDDD
#                      override the guest's GPU subsystem IDs (default: read from the host)
#     --gvt UUID       attach an Intel GVT-g mediated device (a real iGPU adapter);
#                      create the mdev under $IGPU/mdev_supported_types/<type>/ first
#     --gvt-type TYPE  the mdev type `gvt` creates (default i915-GVTg_V5_4)
#     --qemu-arg ARG   append a raw QEMU argument (repeatable; for experiments)
#     --unattend       attach the bundled answer file for a hands-off install
#                      (the BIOS or UEFI layout, chosen to match the firmware)
#     --answer PATH    attach a custom answer file instead of the bundled one
#     --cpu MODEL      override `-cpu` (default host,kvm=off)
#     --revert         `prepare`: undo the boot-time binding
#     --out PATH       `screenshot`: where to write the PNG (default $VM_DIR/screenshot.png)
#     --keys KEYS      `sendkey`: keys to send, in QEMU syntax, e.g. 'shift+f10'
#     --text STR       `type`: the string to type (letters, digits, and \ / . - : _ space)
#     --dry-run        print the commands, change nothing
#
# The guest's user-mode NIC always forwards host 127.0.0.1:2222 to guest port 22. Once the
# guest runs an SSH server (enabled by script/autounattend*.xml) the host can drive it:
#
#     scp -P 2222 build/probe.exe probe@127.0.0.1:/
#     ssh -p 2222 probe@127.0.0.1 'C:\probe.exe'
#     script/interop-vm powerdown                # or: ssh -p 2222 probe@127.0.0.1 'shutdown /s /t 0'
#
# `check` is read-only and safe. `bind`/`unbind`/`prepare` need root and touch the PCI
# device.
#
# `prepare` exists because a live `bind` cannot succeed while the desktop holds the GPU:
# GNOME Shell, terminals and editors open /dev/nvidia* during EGL/Vulkan enumeration, and
# nvidia will not release a device with a non-zero usage count
# (`NVRM: Attempting to remove device ... with non-zero usage count!`). Keeping the GPU
# off the host from boot means passthrough never needs a live unbind, so the guest runs
# alongside the GNOME session.
#
# `prepare` also neuters nvidia *by name* (`install nvidia /bin/true`, plus the DRM/
# modeset/uvm submodules). A blacklist only stops modalias auto-loading; nvidia's udev
# rules force a `modprobe` on every nvidia driver add event, which loops forever once
# vfio-pci owns the GPU (the load fails, nvidia unregisters, the add event re-fires).
# `prepare` therefore also shadows those udev rules with empty files.
#
# The GPU is a MUX-less laptop 3D controller with no readable VBIOS, so QEMU warns
# (`Cannot read device rom at 0000:01:00.0`) and carries on. If the guest driver needs it
# later, pass a dump with `--rom`; `--no-rom` silences the probe instead.

set -euo pipefail

GPU=0000:01:00.0
GPU_SHORT="${GPU#0000:}"
# The Intel iGPU a GVT-g mediated device hangs off (`--gvt`).
IGPU="${INTEROP_VM_IGPU:-0000:00:02.0}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VM_DIR="${INTEROP_VM_DIR:-$HOME/interop-vm}"
DISK_SIZE=64G
RAM=4G
CPUS=2
CPU_MODEL=host,kvm=off
UEFI=0
VNC=0
ROM=""
ROMBAR=""
NO_GPU=0
X_VGA=0
VGA_NONE=0
GPU_SUBSYS=""
GVT_UUID=""
GVT_TYPE=""
GOLDEN_NAME="windows-golden.qcow2"
CLONE_DIR=""
CACHE=""
EXTRA_ARGS=()
QEMU_ARGV=()
ANSWER=""
ANSWER_ISO=""
UNATTEND=0
SHOT_OUT=""
KEYS=""
TYPE_TEXT=""
MONITOR_ADDR=127.0.0.1:4444
DRY_RUN=0
ISO=""
CMD=""

PREPARE_REVERT=0
MODPROBE_CONF=/etc/modprobe.d/vfio-nvidia.conf
MODULES_LOAD=/etc/modules-load.d/vfio-pci.conf
UDEV_RULE=/etc/udev/rules.d/10-vfio.rules
UDEV_MASK_DIR=/etc/udev/rules.d
MEMLOCK_CONF=/etc/security/limits.d/99-vfio-memlock.conf
INITRAMFS_MODULES=/etc/initramfs-tools/modules
VFIO_MODULES="vfio vfio_iommu_type1 vfio_pci"
NVIDIA_UNITS="nvidia-powerd.service nvidia-persistenced.service nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-suspend-then-hibernate.service"

say()  { printf '%s\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

run() {
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would run: $*"
    else
        "$@"
    fi
}

# Write a value to a sysfs node (no trailing newline, which unbind/bind reject).
write_sysfs() {
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would write '$2' to $1"
    else
        printf '%s' "$2" > "$1"
    fi
}

need_root() { [ "$(id -u)" -eq 0 ] || { [ "$DRY_RUN" -eq 1 ] || die "needs root: sudo $0 $CMD"; }; }

usage() { awk 'NR >= 3 && /^#/ { sub(/^# ?/, ""); print; next } NR >= 3 { exit }' "${BASH_SOURCE[0]}"; }

while [ "$#" -gt 0 ]; do
    case "$1" in
        check|bind|unbind|create|install|run|prepare|screenshot|sendkey|type|powerdown|poweron|bake|clone|gvt) CMD="$1" ;;
        --iso)   shift; ISO="${1:?--iso needs a path}" ;;
        --dir)   shift; VM_DIR="${1:?--dir needs a path}" ;;
        --to)    shift; CLONE_DIR="${1:?--to needs a path}" ;;
        --cache) shift; CACHE="${1:?--cache needs a mode}" ;;
        --disk)  shift; DISK_SIZE="${1:?}" ;;
        --ram)   shift; RAM="${1:?}" ;;
        --cpus)  shift; CPUS="${1:?}" ;;
        --cpu)   shift; CPU_MODEL="${1:?}" ;;
        --uefi)  UEFI=1 ;;
        --revert) PREPARE_REVERT=1 ;;
        --vnc)   VNC=1 ;;
        --rom)   shift; ROM="${1:?--rom needs a path}" ;;
        --no-rom) ROMBAR=0 ;;
        --no-gpu) NO_GPU=1 ;;
        --x-vga)  X_VGA=1 ;;
        --no-vga) VGA_NONE=1 ;;
        --gpu-subsys) shift; GPU_SUBSYS="${1:?--gpu-subsys needs VVVV:DDDD}" ;;
        --gvt)       shift; GVT_UUID="${1:?--gvt needs a mediated-device UUID}" ;;
        --gvt-type)  shift; GVT_TYPE="${1:?--gvt-type needs a type}" ;;
        --qemu-arg)   shift; EXTRA_ARGS+=( "$1" ) ;;
        --unattend) UNATTEND=1 ;;
        --answer)   shift; ANSWER="${1:?--answer needs a path}" ;;
        --out)      shift; SHOT_OUT="${1:?--out needs a path}" ;;
        --keys)     shift; KEYS="${1:?--keys needs a value}" ;;
        --text)     shift; TYPE_TEXT="${1:?--text needs a value}" ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help|help) usage; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

[ -n "$CMD" ] || { usage; exit 1; }

iommu_group() { readlink -f "/sys/bus/pci/devices/$GPU/iommu_group" 2>/dev/null | xargs -r basename; }
pci_id() { lspci -n -s "$GPU_SHORT" 2>/dev/null | awk '{print $3}'; }
current_driver() {
    local link="/sys/bus/pci/devices/$GPU/driver"
    if [ -e "$link" ]; then readlink -f "$link" | xargs -r basename; fi
}

# ---------------------------------------------------------------------------------------
# check
# ---------------------------------------------------------------------------------------

cmd_check() {
    say "interop VM"
    say
    say "host"
    note "gpu:    $(lspci -nn -s "$GPU_SHORT" 2>/dev/null | cut -d' ' -f2- || echo 'not found')"
    note "group:  $(iommu_group)"
    note "driver: $(current_driver || echo none)"
    note "kvm:    $([ -w /dev/kvm ] && echo writable || echo 'NOT writable')"
    local iommu
    iommu="$(journalctl -k -b 0 --no-pager 2>/dev/null | grep -m1 'Default domain type' | sed 's/.*kernel: //' || true)"
    note "iommu:  ${iommu:-unknown}"
    say
    say "tooling"
    note "qemu-system-x86_64: $(command -v qemu-system-x86_64 || echo missing)"
    note "qemu-img:           $(command -v qemu-img || echo missing)"
    [ "$UEFI" -eq 1 ] && note "OVMF:               $(ovmf_code || echo 'missing — apt install ovmf')"
    say
    say "vm"
    note "dir:  $VM_DIR"
    note "disk: $([ -f "$VM_DIR/windows.qcow2" ] && qemu-img info "$VM_DIR/windows.qcow2" | grep -m1 virtual || echo 'not created (run: create)')"
    note "free: $(df -h "$(dirname "$VM_DIR")" 2>/dev/null | awk 'NR==2{print $4}')"
    say
    say "next:"
    if [ "$(current_driver)" != "vfio-pci" ]; then
        note "sudo $0 prepare   # keep the GPU for VFIO across boots (recommended)"
        note "sudo $0 bind      # one-off; fails while GNOME/editors hold /dev/nvidia*"
    fi
    [ -f "$VM_DIR/windows.qcow2" ] || note "$0 create"
    note "$0 install --iso <path-to-windows.iso>"
    note "$0 run"
}

# ---------------------------------------------------------------------------------------
# bind / unbind
# ---------------------------------------------------------------------------------------

cmd_bind() {
    need_root
    local driver; driver="$(current_driver)"
    if [ "$driver" = "vfio-pci" ]; then
        say "$GPU is already bound to vfio-pci"
        return 0
    fi
    say "loading vfio-pci"
    run modprobe vfio-pci
    say "setting $GPU driver_override to vfio-pci"
    write_sysfs "/sys/bus/pci/devices/$GPU/driver_override" vfio-pci
    if [ -n "$driver" ]; then
        say "unbinding $GPU from $driver"
        write_sysfs "/sys/bus/pci/drivers/$driver/unbind" "$GPU"
    fi
    say "binding $GPU to vfio-pci"
    write_sysfs /sys/bus/pci/drivers/vfio-pci/bind "$GPU"
    [ "$DRY_RUN" -eq 1 ] || lspci -nnk -s "$GPU_SHORT"
}

cmd_unbind() {
    need_root
    if [ "$(current_driver)" = "vfio-pci" ]; then
        say "unbinding $GPU from vfio-pci"
        write_sysfs /sys/bus/pci/drivers/vfio-pci/unbind "$GPU"
    fi
    say "clearing driver_override"
    write_sysfs "/sys/bus/pci/devices/$GPU/driver_override" ""
    say "probing $GPU back to its default driver"
    write_sysfs /sys/bus/pci/drivers_probe "$GPU"
    [ "$DRY_RUN" -eq 1 ] || lspci -nnk -s "$GPU_SHORT"
}

# ---------------------------------------------------------------------------------------
# prepare / prepare --revert
# ---------------------------------------------------------------------------------------

# Write a root-owned config file (no-op under --dry-run), keeping one .bak of whatever
# was there.
write_conf() { # path content
    local path="$1" content="$2"
    if [ "$DRY_RUN" -eq 1 ]; then
        say "  would write $path:"
        printf '%s\n' "$content" | sed 's/^/    /'
        return
    fi
    [ -f "$path" ] && [ ! -f "$path.interop-vm.bak" ] && cp -a "$path" "$path.interop-vm.bak"
    printf '%s\n' "$content" > "$path"
}

remove_file() { # path
    if [ ! -e "$1" ]; then
        note "no $1"
        return
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would remove $1"
    else
        rm -f "$1"
        say "removed $1"
    fi
}

# Masking stops the nvidia *services* (nvidia-powerd performs an explicit `modprobe` at
# boot). Stopping nvidia from ever loading is done by the `install ... /bin/true` lines in
# MODPROBE_CONF, which neutralize every explicit `modprobe` too.
unit_exists() { [ -f "/usr/lib/systemd/system/$1" ] || [ -f "/lib/systemd/system/$1" ] || [ -f "/etc/systemd/system/$1" ]; }

drop_initramfs_modules() {
    local m
    for m in $VFIO_MODULES; do
        if [ "$DRY_RUN" -eq 1 ]; then
            note "would drop $m from $INITRAMFS_MODULES (if present)"
        elif grep -qxF "$m" "$INITRAMFS_MODULES" 2>/dev/null; then
            sed -i "/^${m}$/d" "$INITRAMFS_MODULES"
            note "dropped $m from $INITRAMFS_MODULES"
        fi
    done
}

# The nvidia driver package installs udev rules that `modprobe` the module by name (and
# ask systemd to start nvidia-persistenced) on every nvidia driver event. Shadow each
# file with an empty one in /etc so those RUN+/SYSTEMD_WANTS lines never fire while the
# GPU belongs to vfio-pci. (An empty /etc file of the same name overrides /usr/lib; /lib
# and /usr/lib are one directory on usr-merged systems, hence the dedupe.)
nvidia_udev_rule_names() {
    local dir f
    for dir in /usr/lib/udev/rules.d /lib/udev/rules.d; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*nvidia*.rules; do
            [ -e "$f" ] || continue
            basename "$f"
        done
    done | sort -u
}

mask_nvidia_udev_rules() {
    local base
    while IFS= read -r base; do
        [ -n "$base" ] || continue
        run ln -sf /dev/null "$UDEV_MASK_DIR/$base"
    done < <(nvidia_udev_rule_names)
}

unmask_nvidia_udev_rules() {
    local base mask
    while IFS= read -r base; do
        [ -n "$base" ] || continue
        mask="$UDEV_MASK_DIR/$base"
        if [ -L "$mask" ]; then remove_file "$mask"; fi
    done < <(nvidia_udev_rule_names)
}

cmd_prepare() {
    need_root
    local id; id="$(pci_id)"
    [ -n "$id" ] || die "could not read the PCI id of $GPU_SHORT"

    say "$GPU ($id) stays on vfio-pci from boot; the host will not load nvidia for it"
    say
    say "1. blacklist and neuter the host drivers, and claim the id for vfio-pci"
    write_conf "$MODPROBE_CONF" \
"# Managed by script/interop-vm prepare --revert.
# Keep the discrete GPU available to VFIO passthrough instead of the host.
blacklist nouveau
blacklist nvidia
blacklist nvidia_drm
blacklist nvidia_modeset
blacklist nvidia_uvm
blacklist nvidiafb
# A blacklist only blocks modalias auto-loading. The nvidia udev rules
# (/usr/lib/udev/rules.d/71-nvidia.rules) run an explicit 'modprobe nvidia-uvm' on
# every nvidia driver add event; with the GPU on vfio-pci that load fails, nvidia
# unregisters, and the event re-fires - an endless modprobe loop. The 'install'
# lines below make those explicit modprobes no-ops, so nvidia never registers and
# the loop cannot start.
install nvidia /bin/true
install nvidia_drm /bin/true
install nvidia_modeset /bin/true
install nvidia_uvm /bin/true
options vfio-pci ids=$id"

    say "2. load vfio-pci at boot, so it claims the GPU"
    write_conf "$MODULES_LOAD" "vfio-pci"

    say "3. mask the nvidia services and udev rules that load the module anyway"
    say "   (a blacklist stops udev auto-loading, not an explicit modprobe by name)"
    local u
    for u in $NVIDIA_UNITS; do
        if unit_exists "$u"; then
            run systemctl mask --now "$u"
        fi
    done
    mask_nvidia_udev_rules

    say "4. let the seated user open the vfio group node"
    say "   (/dev/vfio/<group> is root-only by default; this grants the user an ACL)"
    write_conf "$UDEV_RULE" '# Managed by script/interop-vm prepare --revert.
# Grant the seated user access to /dev/vfio/<group> for passthrough.
SUBSYSTEM=="vfio", TAG+="uaccess"'
    run udevadm control --reload-rules
    run udevadm trigger --subsystem-match=vfio

    say "5. raise the memlock limit (QEMU locks guest RAM to map it via the IOMMU)"
    local mlock_user="${SUDO_USER:-$USER}"
    if [ "$mlock_user" = "root" ]; then mlock_user="*"; fi
    write_conf "$MEMLOCK_CONF" "# Managed by script/interop-vm prepare --revert.
# QEMU must lock the whole guest RAM to map it through the IOMMU.
$mlock_user - memlock unlimited"

    say
    say "reboot or log back in (the memlock limit applies at login), then:"
    note "$0 check                 # driver: should read vfio-pci"
    note "$0 install --iso <path>  # boot the installer"
}

cmd_prepare_revert() {
    say "undoing the boot-time VFIO binding"
    remove_file "$MODPROBE_CONF"
    remove_file "$MODULES_LOAD"
    local u
    for u in $NVIDIA_UNITS; do
        if unit_exists "$u"; then
            run systemctl unmask "$u"
        fi
    done
    remove_file "$UDEV_RULE"
    remove_file "$MEMLOCK_CONF"
    unmask_nvidia_udev_rules
    drop_initramfs_modules
    run udevadm control --reload-rules
    run udevadm trigger --subsystem-match=vfio
    say "reboot to let the host driver take the GPU again"
}

# ---------------------------------------------------------------------------------------
# create / install / run
# ---------------------------------------------------------------------------------------

cmd_create() {
    have qemu-img || die "qemu-img is not installed"
    run mkdir -p "$VM_DIR"
    [ -f "$VM_DIR/windows.qcow2" ] && [ "$DRY_RUN" -eq 0 ] && die "$VM_DIR/windows.qcow2 already exists"
    run qemu-img create -f qcow2 "$VM_DIR/windows.qcow2" "$DISK_SIZE"
}

ovmf_code() {
    local p
    for p in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd \
             /usr/share/edk2/ovmf/OVMF_CODE.fd; do
        [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

ovmf_vars_src() {
    local p
    for p in /usr/share/OVMF/OVMF_VARS_4M.fd /usr/share/OVMF/OVMF_VARS.fd \
             /usr/share/edk2/ovmf/OVMF_VARS.fd; do
        [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

qemu_argv() { # boot-order [cdrom]  -> populates the global QEMU_ARGV array
    local boot="$1" cdrom="${2:-}"
    local cache=""
    if [ -n "$CACHE" ]; then cache=",cache=$CACHE"; fi
    local vfio="vfio-pci,host=$GPU_SHORT"
    if [ -n "$ROM" ]; then vfio="$vfio,romfile=$ROM"; fi
    if [ -n "$ROMBAR" ]; then vfio="$vfio,rombar=$ROMBAR"; fi
    if [ "$X_VGA" -eq 1 ]; then vfio="$vfio,x-vga=on"; fi

    # This GPU's *standard* PCI subsystem registers read 0; the real IDs (1028:070b, Dell) live
    # in a PCIe capability that VFIO does not forward. Without them the guest sees
    # SUBSYS_00000000, and every NVIDIA INF entry for the 930M is subsystem-qualified, so the
    # driver matches no device ("0 devices found"). Forward the host's subsystem IDs with
    # QEMU's vfio-pci debug overrides; `--gpu-subsys` can force a value instead.
    local subv="$GPU_SUBSYS" subd=""
    if [ -n "$subv" ]; then
        subd="${subv##*:}"; subv="${subv%%:*}"
    else
        subv="$(cat "/sys/bus/pci/devices/$GPU/subsystem_vendor" 2>/dev/null)"
        subd="$(cat "/sys/bus/pci/devices/$GPU/subsystem_device" 2>/dev/null)"
    fi
    subv="${subv#0x}"; subd="${subd#0x}"
    if [ -n "$subv" ] && [ -n "$subd" ] && [ "$subv" != 0000 ] && [ "$subd" != 0000 ]; then
        vfio="$vfio,x-pci-sub-vendor-id=0x$subv,x-pci-sub-device-id=0x$subd"
    fi

    QEMU_ARGV=(
        -name interop-windows
        -monitor "tcp:$MONITOR_ADDR,server,nowait"
        -enable-kvm
        -machine q35
        -cpu "$CPU_MODEL"
        -smp "$CPUS"
        -m "$RAM"
        -drive "file=$VM_DIR/windows.qcow2,if=none,id=disk0,format=qcow2,discard=unmap$cache"
        -device "ide-hd,drive=disk0,bus=ide.0"
        -device qemu-xhci
        -device usb-tablet
        -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22"
        -device "e1000,netdev=net0"
        -boot "order=$boot"
    )
    # Emulated VGA is the normal path; --no-vga drops it so a passed-through GPU with
    # x-vga=on can be the guest's primary/boot display adapter instead.
    if [ "$VGA_NONE" -eq 1 ]; then
        QEMU_ARGV+=( -vga none )
    else
        QEMU_ARGV+=( -vga std )
    fi
    # The GPU is the point of this VM, but a plain install or a debug boot can leave it
    # out and keep the guest to one well-understood adapter.
    if [ "$NO_GPU" -eq 0 ]; then
        QEMU_ARGV+=( -device "$vfio" )
    fi
    # A GVT-g mediated iGPU is a *second* hardware adapter; an mdev needs no IOMMU group.
    if [ -n "$GVT_UUID" ]; then
        QEMU_ARGV+=( -device "vfio-pci,sysfsdev=/sys/bus/pci/devices/$IGPU/$GVT_UUID" )
    fi
    # Raw extra arguments, for experiments (e.g. -smbios). Repeatable.
    if [ "${#EXTRA_ARGS[@]}" -gt 0 ]; then
        QEMU_ARGV+=( "${EXTRA_ARGS[@]}" )
    fi
    if [ "$UEFI" -eq 1 ]; then
        local code; code="$(ovmf_code)" || die "no OVMF firmware found — apt install ovmf"
        local vars_src; vars_src="$(ovmf_vars_src)" || die "no OVMF vars template found"
        [ -f "$VM_DIR/OVMF_VARS.fd" ] || run cp "$vars_src" "$VM_DIR/OVMF_VARS.fd"
        QEMU_ARGV+=(
            -drive "if=pflash,format=raw,readonly=on,file=$code"
            -drive "if=pflash,format=raw,file=$VM_DIR/OVMF_VARS.fd"
        )
    fi
    [ -n "$cdrom" ] && QEMU_ARGV+=( -cdrom "$cdrom" )
    [ -n "$ANSWER_ISO" ] && QEMU_ARGV+=( -drive "file=$ANSWER_ISO,media=cdrom,readonly=on,index=1" )
    if [ "$VNC" -eq 1 ]; then
        QEMU_ARGV+=( -display none -vnc 127.0.0.1:0 )
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        QEMU_ARGV+=( -display gtk )
    else
        QEMU_ARGV+=( -display none -vnc 127.0.0.1:0 )
    fi
}

# The bundled answer file comes in two layouts — BIOS/MBR and UEFI/GPT — so pick the one
# that matches the firmware.
pick_answer_file() {
    [ "$UNATTEND" -eq 1 ] || return 0
    if [ "$UEFI" -eq 1 ]; then
        ANSWER="$SCRIPT_DIR/autounattend-uefi.xml"
    else
        ANSWER="$SCRIPT_DIR/autounattend.xml"
    fi
}

# Stage the answer file as `autounattend.xml` at the root of a small ISO, attached as a
# second CD-ROM. Setup does scan it for that name (it picked the product key up from
# here), and the disc stays attached across Setup's reboots, so the oobeSystem pass is
# found too.
build_answer_iso() {
    [ -n "$ANSWER" ] || return 0
    [ -f "$ANSWER" ] || die "no such answer file: $ANSWER"
    have genisoimage || die "genisoimage is required to stage the answer file"
    ANSWER_ISO="$VM_DIR/autounattend.iso"
    say "staging the answer file as $ANSWER_ISO"
    run mkdir -p "$VM_DIR/answer"
    run cp "$ANSWER" "$VM_DIR/answer/autounattend.xml"
    run genisoimage -quiet -J -iso-level 4 -o "$ANSWER_ISO" "$VM_DIR/answer/autounattend.xml"
}

# A disk that already carries a bootable partition makes the Windows media stop and ask
# "Press any key to boot from CD or DVD"; with nobody at the keyboard it falls through to
# that partition instead and dies with "An operating system wasn't found". Zero the
# partition table first, so the CD boots straight into Setup with no prompt.
wipe_partition_table() {
    have qemu-io || { note "qemu-io missing; leaving the disk as it is"; return 0; }
    say "clearing the disk's partition table so Setup boots without prompting"
    run qemu-io -f qcow2 -c 'write -z 0 1M' "$VM_DIR/windows.qcow2"
}

cmd_install() {
    [ -n "$ISO" ] || die "install needs --iso <path>"
    [ -f "$ISO" ] || die "no such ISO: $ISO"
    [ -f "$VM_DIR/windows.qcow2" ] || die "no disk — run: $0 create"
    have qemu-system-x86_64 || die "qemu-system-x86_64 is not installed"
    pick_answer_file
    build_answer_iso
    wipe_partition_table
    say "booting the installer with $GPU passed through (boot order: cdrom)"
    qemu_argv d "$ISO"
    run qemu-system-x86_64 "${QEMU_ARGV[@]}"
}

cmd_run() {
    [ -f "$VM_DIR/windows.qcow2" ] || die "no disk — run: $0 create (and install)"
    have qemu-system-x86_64 || die "qemu-system-x86_64 is not installed"

    local what=""
    if [ "$NO_GPU" -eq 0 ]; then
        local drv; drv="$(current_driver)"
        if [ "$drv" != "vfio-pci" ]; then
            die "$GPU is on '${drv:-no driver}', not vfio-pci — the dGPU cannot be passed.  For the GVT-g guest: sudo $0 gvt, then: $0 run --no-gpu --gvt <uuid>"
        fi
        what="$GPU"
    fi
    if [ -n "$GVT_UUID" ]; then
        [ -e "/sys/bus/pci/devices/$IGPU/$GVT_UUID" ] ||
            die "no mediated device $GVT_UUID — create one: sudo $0 gvt"
        what="${what:+$what + }GVT-g $GVT_UUID"
    fi
    say "booting $VM_DIR/windows.qcow2 with ${what:-no GPU}"
    qemu_argv c
    run qemu-system-x86_64 "${QEMU_ARGV[@]}"
}

# ---------------------------------------------------------------------------------------
# screenshot / sendkey — talk to a running VM's monitor
# ---------------------------------------------------------------------------------------

# QEMU's monitor is on a localhost TCP socket (a unix socket would be root-owned when the
# VM runs under sudo, and this user could not connect to it).
monitor_send() { # monitor-command
    have python3 || die "python3 is required"
    if ! python3 - "$MONITOR_ADDR" "$1" <<'PY'
import socket, sys, time
host, port = sys.argv[1].rsplit(':', 1)
mon = socket.create_connection((host, int(port)), timeout=5)
mon.sendall((sys.argv[2] + "\n").encode())
time.sleep(0.5)
PY
    then
        die "could not reach the monitor at $MONITOR_ADDR (is the VM running?)"
    fi
}

cmd_screenshot() {
    local out="${SHOT_OUT:-$VM_DIR/screenshot.png}"
    local ppm="$VM_DIR/screenshot.ppm"
    rm -f "$ppm"
    monitor_send "screendump $ppm"
    # The VM may run under sudo, so QEMU writes the file as root, and it can land a moment
    # after the monitor returns. Wait for it to appear and stop growing before reading it.
    local prev=-1 size i
    for i in $(seq 1 60); do
        size=$(stat -c %s "$ppm" 2>/dev/null || echo 0)
        if [ "$size" -gt 0 ] && [ "$size" = "$prev" ]; then break; fi
        prev="$size"
        sleep 0.1
    done
    python3 - "$ppm" "$out" <<'PY'
import sys
from PIL import Image
Image.open(sys.argv[1]).save(sys.argv[2])
PY
    rm -f "$ppm"
    say "screenshot: $out"
}

cmd_sendkey() {
    [ -n "$KEYS" ] || die "sendkey needs --keys (e.g. --keys 'shift+f10')"
    monitor_send "sendkey $KEYS"
    say "sent: $KEYS"
}

# Type a string one key at a time. Only the characters a typing-in-a-console command
# needs are mapped; anything unmapped is skipped.
cmd_type() {
    [ -n "$TYPE_TEXT" ] || die "type needs --text STR"
    have python3 || die "python3 is required"
    if ! python3 - "$MONITOR_ADDR" "$TYPE_TEXT" <<'PY'
import socket, sys, time

NAMED = {
    ' ': 'spc', '\\': 'backslash', '/': 'slash', '.': 'dot', '-': 'minus',
    ':': 'shift-semicolon', '_': 'shift-minus', '=': 'equal',
    ',': 'comma', ';': 'semicolon', "'": 'apostrophe', '"': 'shift-apostrophe',
    '[': 'bracket_left', ']': 'bracket_right', '`': 'grave_accent',
    '~': 'shift-grave_accent', '!': 'shift-1', '@': 'shift-2', '#': 'shift-3',
    '$': 'shift-4', '%': 'shift-5', '^': 'shift-6', '&': 'shift-7', '*': 'shift-8',
    '(': 'shift-9', ')': 'shift-0', '+': 'shift-equal', '{': 'shift-bracket_left',
    '}': 'shift-bracket_right', '|': 'shift-backslash', '<': 'shift-comma',
    '>': 'shift-dot', '?': 'shift-slash',
}

def key_for(c):
    if c in NAMED:
        return NAMED[c]
    if c.isalnum():
        return c
    return None

host, port = sys.argv[1].rsplit(':', 1)
sock = socket.create_connection((host, int(port)), timeout=5)
for c in sys.argv[2]:
    k = key_for(c)
    if k is None:
        continue
    sock.sendall(("sendkey %s\n" % k).encode())
    time.sleep(0.06)
PY
    then
        die "could not reach the monitor at $MONITOR_ADDR (is the VM running?)"
    fi
    say "typed: $TYPE_TEXT"
}

# ACPI power-down — the same as pressing the power button. Needs no guest agent, so it
# works before SSH is set up.
cmd_powerdown() {
    monitor_send "system_powerdown"
    say "sent ACPI power-down"
}

# ---------------------------------------------------------------------------------------
# poweron — run the board's ACPI _ON for the dGPU
# ---------------------------------------------------------------------------------------

# On a MUX-less laptop the discrete GPU core is powered down until the vendor driver asks the
# firmware to power it (ACPI `_ON`, which pokes the EC). A guest can never reach that host
# method, so it runs here, on the host, before the VM starts:
#
#     sudo apt install acpi-call-dkms
#     sudo modprobe acpi_call
#     sudo script/interop-vm poweron
#
# `_ON` writes the GPU's command register and the EC, so it wants root; acpi_call must be
# loaded first (`/proc/acpi/call`). The method lives at the GPU's own ACPI node, which the
# firmware_node symlink names authoritatively (here \_SB_.PCI0.RP01.PEGP).
cmd_poweron() {
    local fw="/sys/bus/pci/devices/$GPU/firmware_node/path"
    [ -e "$fw" ] || die "no ACPI firmware_node path for $GPU (is the GPU present?)"
    local apath; apath="$(cat "$fw")"
    [ -n "$apath" ] || die "empty ACPI path for $GPU"
    local before after
    before="$(cat "/sys/bus/pci/devices/$GPU/power_state" 2>/dev/null)"
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would write '$apath._ON' to /proc/acpi/call"
        return 0
    fi
    [ -e /proc/acpi/call ] || die "acpi_call is not loaded — run: sudo modprobe acpi_call (package: acpi-call-dkms)"
    need_root
    printf '%s._ON' "$apath" > /proc/acpi/call
    after="$(tr -d '\000' < /proc/acpi/call 2>/dev/null)"
    say "_ON on $apath: $after"
    say "power_state: $before -> $(cat "/sys/bus/pci/devices/$GPU/power_state" 2>/dev/null)"
}

# ---------------------------------------------------------------------------------------
# gvt — recreate the mediated Intel GPU after a host reboot
# ---------------------------------------------------------------------------------------

# The GVT-g mdev does not survive a host reboot: `kvmgt` must be loaded and the mdev created
# again, both as root. This does it and prints the `run` line to paste:
#
#     sudo script/interop-vm gvt
#     script/interop-vm run --no-gpu --gvt <uuid>
#
# The type defaults to i915-GVTg_V5_4 (128 MB low / 512 MB high GM); `--gvt-type` overrides
# it. The UUID is also saved to $VM_DIR/gvt.uuid.
cmd_gvt() {
    need_root
    local types="/sys/bus/pci/devices/$IGPU/mdev_supported_types"
    local type="${GVT_TYPE:-i915-GVTg_V5_4}"
    if ! lsmod | grep -q '^kvmgt'; then
        say "loading kvmgt"
        if [ "$DRY_RUN" -eq 1 ]; then
            note "would run: modprobe kvmgt"
            note "would write a uuid to $types/$type/create"
            return 0
        fi
        modprobe kvmgt
    fi
    [ -d "$types" ] || die "no GVT-g types at $types — is i915.enable_gvt=1 on the kernel cmdline?"
    [ -d "$types/$type" ] || die "no mdev type '$type' (have: $(ls "$types" | tr '\n' ' '))"
    local uuid
    uuid="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen)"
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would write $uuid to $types/$type/create"
        return 0
    fi
    printf '%s' "$uuid" > "$types/$type/create"
    mkdir -p "$VM_DIR"
    printf '%s\n' "$uuid" > "$VM_DIR/gvt.uuid"
    say "GVT-g mediated device ready: $uuid  ($type)"
    say "saved to $VM_DIR/gvt.uuid"
    say
    say "start the VM with:"
    note "$0 run --dir $VM_DIR --ram 3G --cpu 'host,kvm=off,-hypervisor,hv_vendor_id=0123456789ab' --no-gpu --gvt $uuid --vnc"
}

# ---------------------------------------------------------------------------------------
# bake / clone — a golden image, and per-VM overlays on it
# ---------------------------------------------------------------------------------------

# Booting a probe VM should be a copy, not a Windows install. `bake` freezes the installed,
# driver-complete disk as $VM_DIR/$GOLDEN_NAME (made read-only) and replaces the working disk
# with a qcow2 overlay on it, so the VM carries on unchanged. `clone --to DIR` makes another
# overlay for a fresh VM. The golden is a dependency of every overlay: keep it, or they break.
#
#     script/interop-vm powerdown            # the VM must be stopped
#     script/interop-vm bake
#     script/interop-vm clone --to ~/interop-vm-2
#
# Run one guest at a time on this host: the SSH forward and the monitor port are fixed (2222,
# 4444), and the GVT-g mdev allows a single instance.

vm_up() { # 0 if a monitor is answering on $MONITOR_ADDR
    have python3 || return 1
    python3 - "$MONITOR_ADDR" <<'PY' 2>/dev/null
import socket, sys
host, port = sys.argv[1].rsplit(':', 1)
socket.create_connection((host, int(port)), timeout=2).close()
PY
}

overlay_backing() { # the backing filename of a qcow2, empty if it has none
    qemu-img info --output=json "$1" 2>/dev/null |
        python3 -c 'import json,sys; print(json.load(sys.stdin).get("backing-filename",""))' 2>/dev/null
}

cmd_bake() {
    have qemu-img || die "qemu-img is not installed"
    [ -f "$VM_DIR/windows.qcow2" ] || die "no disk to bake — run: $0 create (and install)"
    if vm_up; then die "a VM is running — power it down first: $0 powerdown"; fi
    local golden="$VM_DIR/$GOLDEN_NAME"
    if [ -f "$golden" ]; then die "$golden already exists (remove it to re-bake)"; fi
    if [ -n "$(overlay_backing "$VM_DIR/windows.qcow2")" ]; then
        die "$VM_DIR/windows.qcow2 is already an overlay on a golden image"
    fi
    run mv "$VM_DIR/windows.qcow2" "$golden"
    run chmod a-w "$golden"
    run qemu-img create -f qcow2 -F qcow2 -b "$(readlink -f "$golden")" "$VM_DIR/windows.qcow2"
    say "baked $golden; $VM_DIR/windows.qcow2 is now an overlay on it"
    say "a fresh VM: $0 clone --to DIR"
}

cmd_clone() {
    have qemu-img || die "qemu-img is not installed"
    local golden="$VM_DIR/$GOLDEN_NAME"
    [ -f "$golden" ] || die "no golden image at $golden — bake one first: $0 bake"
    [ -n "$CLONE_DIR" ] || die "clone needs --to DIR"
    local dest="$CLONE_DIR/windows.qcow2"
    if [ -e "$dest" ] && [ "$DRY_RUN" -eq 0 ]; then die "$dest already exists"; fi
    run mkdir -p "$CLONE_DIR"
    run qemu-img create -f qcow2 -F qcow2 -b "$(readlink -f "$golden")" "$dest"
    say "clone ready: $0 run --dir $CLONE_DIR --gvt <uuid> ..."
}

case "$CMD" in
    check)   cmd_check ;;
    bind)    cmd_bind ;;
    unbind)  cmd_unbind ;;
    prepare) if [ "$PREPARE_REVERT" -eq 1 ]; then cmd_prepare_revert; else cmd_prepare; fi ;;
    create)  cmd_create ;;
    install) cmd_install ;;
    run)     cmd_run ;;
    screenshot) cmd_screenshot ;;
    sendkey) cmd_sendkey ;;
    type)    cmd_type ;;
    powerdown) cmd_powerdown ;;
    poweron)   cmd_poweron ;;
    bake)      cmd_bake ;;
    clone)     cmd_clone ;;
    gvt)       cmd_gvt ;;
esac
