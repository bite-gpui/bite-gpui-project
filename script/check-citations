#!/usr/bin/env python3
"""Check the `path:line` citations in this repository's documents.

Print, don't judge. Every citation is resolved against a ref and printed with the line
it currently points at, so a wrong number is visible rather than hidden. When a citation
lands on a blank line — the usual symptom of drift — the check hunts the symbols named in
the surrounding prose and reports where each is now defined, so a stale number can be
re-pointed without eyeballing the file.

Exits non-zero only when a cited file is missing, an unresolved citation is found, or a
line number is out of range — the cases that are unambiguously wrong rather than merely
stale.

    script/check-citations                  # against the canonical ref
    script/check-citations --ref regenerated
    script/check-citations --worktree       # against this checkout
    script/check-citations --problems       # only the ones that need attention
    script/check-citations --drift          # only the ones whose line is now blank
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import citations


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--ref", default=citations.CANONICAL_REF,
                        help=f"the ref to resolve against (default: {citations.CANONICAL_REF})")
    parser.add_argument("--worktree", action="store_true",
                        help="resolve against this checkout instead of a ref")
    parser.add_argument("--problems", action="store_true",
                        help="print only the citations that need attention")
    parser.add_argument("--drift", action="store_true",
                        help="print only the citations whose line is now blank")
    parser.add_argument("documents", nargs="*",
                        help="documents to check (default: every .md here)")
    args = parser.parse_args()

    docs_dir = citations.docs_root(citations.repo_root())
    source = citations.source_root(docs_dir)
    ref = None if args.worktree else citations.resolve_ref(source, args.ref)
    where = "the working tree" if ref is None else f"ref {args.ref}"

    docs = [Path(d) for d in args.documents] or sorted(
        p
        for p in docs_dir.glob("**/*.md")
        # A symlinked document is a view of one that is checked where it lives, so
        # following it here would count its citations twice.
        # `spi/rendering-project/` is nothing but symlinks.
        if ".git" not in p.parts and not p.is_symlink()
    )

    checked = unresolved = missing = out_of_range = blanks = 0
    failing = False
    for doc in docs:
        if not doc.is_file():
            print(f"{doc}: no such document", file=sys.stderr)
            failing = True
            continue
        lines = doc.read_text().splitlines()
        try:
            relative = doc.relative_to(docs_dir)
        except ValueError:
            relative = doc
        for number, text in enumerate(lines, start=1):
            for match in citations.CITATION.finditer(text):
                cited, first, last = match.group(1), int(match.group(2)), match.group(3)
                last = int(last) if last else first
                checked += 1

                kind, path = citations.resolve(source, ref, cited)
                if kind == "unresolved":
                    unresolved += 1
                    failing = True
                    print(f"{relative}:{number}  {cited}:{first}  UNRESOLVED")
                    print(f"    not found under {', '.join(citations.BARE_BASES)}"
                          if "/" not in cited else "    no such file at this ref")
                    continue

                content = (citations.read_registry(path) if kind == "registry"
                           else citations.read_at(source, ref, path))
                if content is None:
                    missing += 1
                    failing = True
                    print(f"{relative}:{number}  {path}:{first}  MISSING")
                    continue
                if last > len(content):
                    out_of_range += 1
                    failing = True
                    print(f"{relative}:{number}  {path}:{first}-{last}  OUT OF RANGE"
                          f" (file is {len(content)} lines)")
                    continue

                shown = content[first - 1].strip()
                if not shown:
                    blanks += 1
                if (args.problems or args.drift) and shown:
                    continue
                print(f"{relative}:{number}  {path}:{first}"
                      f"{'-' + str(last) if last != first else ''}  {shown or '<blank>'}")

                # Drift hint: when the cited line is blank, hunt the symbols named in the
                # prose and report where each is now defined.
                if not shown and kind == "repo":
                    for symbol in citations.symbols_in_text(text):
                        for line_no, sym_kind in citations.find_symbols(content, symbol):
                            print(f"      ~ `{symbol}` is now defined at line {line_no} ({sym_kind})")

    resolved = checked - unresolved - missing - out_of_range
    print(f"\n{checked} citations against {where}: "
          f"{resolved} resolved, {blanks} on blank lines, {unresolved} unresolved, "
          f"{out_of_range} out of range, {missing} missing.")
    print("A blank line is not proof of drift, and a non-blank one is not proof of "
          "agreement: read the lines. Only the last three kinds fail.")
    return 1 if failing else 0


if __name__ == "__main__":
    sys.exit(main())
